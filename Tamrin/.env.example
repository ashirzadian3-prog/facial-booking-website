# Optional: override the EmailJS settings used by the booking form.
# Create them at https://www.emailjs.com/ (Email Services, Email Templates, Account).
# The template should use the variables: from_name, phone, message.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
